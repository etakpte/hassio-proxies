{
    "name": "Flexget Proxy",
    "version": "0.3.0",
    "slug": "flexget_proxy",
    "description": "Proxy for Flexget",
    "url": "https://github.com/etakpte/hassio-proxies/tree/master/flexget-proxy",
    "arch": [
      "aarch64",
      "amd64"
    ],
    "boot": "auto",
    "init": true,
    "true": true,
    "ingress": true,
    "ingress_entry": "/flexget/",
    "timeout": 30,
    "panel_icon": "mdi:alpha-x-box-outline",
    "map": [
      "config:ro"
    ],
    "ports": {
      "8099/tcp": null
    },
    "ports_description": {
      "8099/tcp": "Frontend tcp-listen port"
    },
    "options": {
      "server": null,
      "auth_token": ""
    },
    "schema": {
      "server": "url",
      "auth_token": "str?"
    },
    "image": "ghcr.io/zigbee2mqtt/zigbee2mqtt-proxy-{arch}"
}
